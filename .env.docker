# Docker Compose Local Environment
# Copy this to .env in the root directory for local development

# Database
POSTGRES_USER=promptrouter
POSTGRES_PASSWORD=dev_password_local
POSTGRES_DB=promptrouter

# Application
ENVIRONMENT=development
DEBUG=True

# Security - FOR DEVELOPMENT ONLY
API_SECRET_KEY=dev-secret-key-for-local-testing-only
ENCRYPTION_KEY=dev-encryption-44-chars-fernet-key-local
