# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promptrouter
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/promptrouter

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256

# API Keys (add your keys here)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# CORS
CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# Development
DEBUG=True
